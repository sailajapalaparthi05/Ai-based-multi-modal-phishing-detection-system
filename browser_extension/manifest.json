{
  "manifest_version": 3,
  "name": "AI Phishing Detection — Browser Monitor",
  "version": "1.0.0",
  "description": "Automatically monitors browser activity and sends threat data to AI Phishing Detection Flask backend.",

  "permissions": [
    "tabs",
    "storage",
    "webNavigation",
    "notifications",
    "downloads",
    "activeTab"
  ],

  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}